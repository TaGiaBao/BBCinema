# Copy this file to .env and fill in your values. The .env file is ignored by Git, so it is never pushed.
# Never put real passwords in this example file: it is committed to Git.

# Gmail: turn on 2-step verification, then create an app password at https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_USERNAME=email-cua-ban@gmail.com
MAIL_PASSWORD=mat-khau-ung-dung-16-ky-tu

# VNPay sandbox (https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Chuyển khoản QR (VietQR): tài khoản nhận tiền của rạp. BANK_CODE: MB, VCB, ACB, TCB, BIDV, ICB, TPB, VPB...
BANK_CODE=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# SePay (my.sepay.vn > API Access): khi có token, tiền chuyển vào sẽ tự xác nhận vé. Để trống thì nhân viên xác nhận.
SEPAY_API_TOKEN=

# "Đăng nhập bằng Google" (optional). Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID > Web application, redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Key used to sign login tokens. Generate one with:  openssl rand -base64 32
# Leave it commented out to use the development key.
# JWT_SECRET=

# MySQL (only needed when running without Docker and not using the h2 profile)
DB_USERNAME=root
DB_PASSWORD=root
